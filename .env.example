# Harbourline Maintenance Desk: settings
#
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. This example file is committed, so it must never hold a real value.

# --- Claude (the triage agent and the end-of-call summary) -------------------
# Anthropic Console API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# Runtime model for triage and summaries.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Airtable (the source of truth) -----------------------------------------
# Personal access token. Scopes: data.records:read, data.records:write, schema.bases:read.
AIRTABLE_PAT=
# Your base built from seed/ (starts with "app"). Schema: docs/airtable-schema.md
AIRTABLE_BASE_ID=
# Optional: a published Airtable Interface, used by the Reports link in the menu.
NEXT_PUBLIC_AIRTABLE_INTERFACE_URL=

# --- Vapi (the voice agent, Jane) -------------------------------------------
# Public key: safe in the browser. Starts the call from the Talk to Jane page.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Your assistant, set up from docs/voice-agent-prompt.md.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Private key: server only. Not needed by the app; useful for scripted changes to the assistant.
VAPI_PRIVATE_KEY=

# --- Make.com (voice calls into Airtable) -----------------------------------
# The scenario's Custom webhook URL. Set it as the Vapi assistant's Server URL too.
# The app does not call it; it is here for reference.
MAKE_WEBHOOK_URL=

# Make.com API (optional: lets Claude Code create the scenario for you).
# API calls need 'Authorization: Token <token>' AND a normal User-Agent header,
# or Make's firewall returns 403 'error code: 1010'.
MAKE_API_TOKEN=
MAKE_ZONE=
MAKE_ORG_ID=
MAKE_TEAM_ID=
# Make's Airtable connection ID (an OAuth connection covering all bases works best).
MAKE_AIRTABLE_CONNECTION_ID=
